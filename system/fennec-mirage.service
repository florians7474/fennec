[Unit]
Description=Mirage AP (Fennec module)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fennec-mirage-ap
ExecStopPost=-/usr/bin/pkill -f /tmp/fennec-mirage/dnsmasq.conf
ExecStopPost=-/usr/bin/pkill -f fennec-mirage-portal
ExecStopPost=-/usr/local/bin/fennec-mirage-ap cleanup
Restart=no

[Install]
WantedBy=multi-user.target
