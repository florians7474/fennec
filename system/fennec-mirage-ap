#!/usr/bin/env bash
# Start the Mirage access point using an automatically selected Wi-Fi interface.
# The built-in station interface (wlan0) is kept free whenever possible.
# Usage: fennec-mirage-ap ["SSID" CHANNEL] | fennec-mirage-ap cleanup
set -euo pipefail

AP_IP=10.0.0.1
RUN=/tmp/fennec-mirage
TARGET=/tmp/fennec-mirage-target
IFACE_FILE="$RUN/ap_iface"

mkdir -p "$RUN"

iface_supports_ap() {
  local iface="$1"
  local phy info
  [ -d "/sys/class/net/$iface/phy80211" ] || return 1
  phy="$(cat "/sys/class/net/$iface/phy80211/name" 2>/dev/null || true)"
  [ -n "$phy" ] || return 1
  info="$(iw phy "$phy" info 2>/dev/null)" || return 1
  awk '
    /Supported interface modes:/ { in_modes=1; next }
    in_modes && /^[[:space:]]*\*/ {
      mode=$0
      sub(/^[[:space:]]*\*[[:space:]]*/, "", mode)
      if (mode == "AP") found=1
      next
    }
    in_modes { exit }
    END { exit(found ? 0 : 1) }
  ' <<< "$info"
}

iface_is_connected() {
  local iface="$1"
  iw dev "$iface" link 2>/dev/null | grep -q "^Connected to "
}

iface_is_usb() {
  local iface="$1"
  local device_path
  device_path="$(readlink -f "/sys/class/net/$iface/device" 2>/dev/null || true)"
  [[ "$device_path" == *"/usb"* ]]
}

detect_ap_iface() {
  local iface path
  local -a usb_candidates=()
  local -a other_candidates=()

  if [ -n "${FENNEC_MIRAGE_IFACE:-}" ]; then
    if iface_supports_ap "$FENNEC_MIRAGE_IFACE" && ! iface_is_connected "$FENNEC_MIRAGE_IFACE"; then
      printf '%s\n' "$FENNEC_MIRAGE_IFACE"
      return 0
    fi
    echo "[MIRAGE] FENNEC_MIRAGE_IFACE=$FENNEC_MIRAGE_IFACE is unavailable, connected, or not AP-capable." >&2
    return 1
  fi

  # Never take over a Wi-Fi interface that is already associated as a station.
  for path in /sys/class/net/*; do
    iface="$(basename "$path")"
    iface_supports_ap "$iface" || continue
    iface_is_connected "$iface" && continue
    if iface_is_usb "$iface"; then
      usb_candidates+=("$iface")
    else
      other_candidates+=("$iface")
    fi
  done

  # Prefer an external USB adapter, then any other free AP-capable Wi-Fi interface.
  if [ "${#usb_candidates[@]}" -gt 0 ]; then
    printf '%s\n' "${usb_candidates[0]}"
    return 0
  fi
  if [ "${#other_candidates[@]}" -gt 0 ]; then
    printf '%s\n' "${other_candidates[0]}"
    return 0
  fi

  return 1
}

cleanup_iface() {
  local iface=""
  if [ -f "$IFACE_FILE" ]; then
    iface="$(cat "$IFACE_FILE" 2>/dev/null || true)"
  fi
  if [ -n "$iface" ] && [ -e "/sys/class/net/$iface" ]; then
    ip addr flush dev "$iface" 2>/dev/null || true
  fi
  rm -f "$IFACE_FILE"
}

if [ "${1:-}" = "cleanup" ]; then
  cleanup_iface
  exit 0
fi

IFACE="$(detect_ap_iface || true)"
if [ -z "$IFACE" ]; then
  echo "[MIRAGE] No secondary Wi-Fi interface with AP mode support was found." >&2
  echo "[MIRAGE] Attach a free AP-capable Wi-Fi adapter and try again." >&2
  exit 1
fi

printf '%s\n' "$IFACE" > "$IFACE_FILE"
echo "[MIRAGE] Using AP interface: $IFACE"

SSID="${1:-}"
CHANNEL="${2:-}"
if [ -z "$SSID" ] && [ -f "$TARGET" ]; then
  SSID="$(sed -n '1p' "$TARGET")"
  [ -z "$CHANNEL" ] && CHANNEL="$(sed -n '2p' "$TARGET")"
fi
SSID="${SSID:-Fennec-test}"
CHANNEL="${CHANNEL:-1}"

# Choose the radio band from the target channel. hostapd cannot use a 5 GHz
# channel with the 2.4 GHz "g" mode, which causes it to reject the AP setup.
if [[ "$CHANNEL" =~ ^[0-9]+$ ]] && [ "$CHANNEL" -ge 1 ] && [ "$CHANNEL" -le 14 ]; then
  HW_MODE=g
elif [[ "$CHANNEL" =~ ^[0-9]+$ ]] && [ "$CHANNEL" -ge 32 ] && [ "$CHANNEL" -le 196 ]; then
  HW_MODE=a
else
  echo "[MIRAGE] Invalid or unsupported channel '$CHANNEL'; falling back to 2.4 GHz channel 1." >&2
  CHANNEL=1
  HW_MODE=g
fi

nmcli dev set "$IFACE" managed no 2>/dev/null || true
ip addr flush dev "$IFACE" 2>/dev/null || true
ip addr add "$AP_IP/24" dev "$IFACE"
ip link set "$IFACE" up

cat > "$RUN/hostapd.conf" <<EOF
interface=$IFACE
driver=nl80211
ssid=$SSID
hw_mode=$HW_MODE
channel=$CHANNEL
country_code=FR
ieee80211d=1
EOF

cat > "$RUN/dnsmasq.conf" <<EOF
interface=$IFACE
bind-interfaces
dhcp-range=10.0.0.10,10.0.0.100,12h
dhcp-option=3,$AP_IP
dhcp-option=6,$AP_IP
address=/#/$AP_IP
dhcp-leasefile=$RUN/leases
EOF

# Reset the live client list when Mirage starts.
: > "$RUN/leases"

pkill -f "$RUN/dnsmasq.conf" 2>/dev/null || true
pkill -f fennec-mirage-portal 2>/dev/null || true
sleep 1

dnsmasq -C "$RUN/dnsmasq.conf"

mkdir -p /opt/fennec-mirage/portal
python3 /usr/local/bin/fennec-mirage-portal &

exec hostapd "$RUN/hostapd.conf"
