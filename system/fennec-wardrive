#!/usr/bin/env python3
# Fennec wardrive logger.
#
# While Pwnagotchi (and therefore bettercap) is running, poll bettercap's REST
# API for every access point in range and tag each one with the current GPS
# fix. This is passive observation only (listing what is broadcast in the air,
# like WiGLE) and runs alongside handshake capture on the same walk, reusing the
# single monitor interface already held by bettercap.
#
# Output: /etc/pwnagotchi/wardrive.json, a dict keyed by BSSID, read by the
# Fennec Map module to draw grey points (networks seen without a handshake).

import base64
import json
import os
import re
import time
import urllib.request

CAPLET = "/etc/pwnagotchi/pwnagotchi-auto.cap"
API = "http://127.0.0.1:8081/api/session"
STORE = "/etc/pwnagotchi/wardrive.json"
INTERVAL = 5  # seconds between polls


def api_creds():
    user = pw = ""
    try:
        with open(CAPLET, encoding="utf-8") as f:
            for line in f:
                m = re.match(r"\s*set\s+api\.rest\.username\s+(\S+)", line)
                if m:
                    user = m.group(1)
                m = re.match(r"\s*set\s+api\.rest\.password\s+(\S+)", line)
                if m:
                    pw = m.group(1)
    except OSError:
        pass
    return user, pw


def load_store():
    try:
        with open(STORE, encoding="utf-8") as f:
            d = json.load(f)
            return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_store(d):
    tmp = STORE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(d, f)
    os.replace(tmp, STORE)
    try:
        os.chmod(STORE, 0o644)
    except OSError:
        pass


def main():
    user, pw = api_creds()
    auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
    store = load_store()

    while True:
        time.sleep(INTERVAL)
        try:
            req = urllib.request.Request(API, headers={"Authorization": "Basic " + auth})
            with urllib.request.urlopen(req, timeout=4) as r:
                data = json.load(r)
        except Exception:
            continue

        gps = data.get("gps") or {}
        try:
            lat = float(gps.get("Latitude") or 0)
            lon = float(gps.get("Longitude") or 0)
            sats = int(gps.get("NumSatellites") or 0)
            fix = str(gps.get("FixQuality") or "0")
        except (TypeError, ValueError):
            continue
        # Only log with a reliable fix, otherwise the position is meaningless.
        if fix == "0" or sats < 3 or (lat == 0 and lon == 0):
            continue

        aps = (data.get("wifi") or {}).get("aps") or []
        now = int(time.time())
        changed = False
        for ap in aps:
            bssid = (ap.get("mac") or "").upper()
            if not bssid:
                continue
            try:
                rssi = int(ap.get("rssi") or -999)
            except (TypeError, ValueError):
                rssi = -999
            essid = ap.get("hostname") or ""
            chan = ap.get("channel") or 0
            enc = ap.get("encryption") or ""
            cur = store.get(bssid)
            if cur is None:
                store[bssid] = {
                    "nom": essid, "bssid": bssid, "lat": lat, "lon": lon,
                    "rssi": rssi, "channel": chan, "enc": enc,
                    "first": now, "last": now,
                }
                changed = True
            else:
                cur["last"] = now
                if essid and not cur.get("nom"):
                    cur["nom"] = essid
                # Keep the position recorded where the signal was strongest,
                # i.e. closest to the access point.
                if rssi > cur.get("rssi", -999):
                    cur["rssi"] = rssi
                    cur["lat"] = lat
                    cur["lon"] = lon
                changed = True

        if changed:
            save_store(store)


if __name__ == "__main__":
    main()
