[Unit]
Description=Scout handshake harvester (Fennec module)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fennec-scout
ExecStopPost=-/usr/bin/pkill -f "hcxdumptool.*fennec-scout"
ExecStopPost=-/usr/bin/pkill -f "aireplay-ng.*--deauth"
Restart=no

[Install]
WantedBy=multi-user.target
